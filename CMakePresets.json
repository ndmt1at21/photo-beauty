{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Release with debug info",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "debug",
      "inherits": "default",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "asan",
      "displayName": "ASan + UBSan (GCC/Clang)",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "TSan (GCC/Clang)",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "profile",
      "displayName": "Tracy profiler zones",
      "inherits": "default",
      "cacheVariables": { "PB_TRACY": "ON" }
    },
    {
      "name": "ui",
      "displayName": "Core + Qt Quick UI, on Ubuntu 24.04 (Qt from $QT_ROOT_DIR)",
      "inherits": "default",
      "cacheVariables": { "PB_UI": "ON", "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}" }
    },
    {
      "name": "mingw",
      "displayName": "Windows x64 from Linux/WSL (llvm-mingw on PATH)",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_C_COMPILER": "x86_64-w64-mingw32-clang",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-clang++",
        "CMAKE_EXE_LINKER_FLAGS": "-static",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static"
      }
    }
  ]
}
